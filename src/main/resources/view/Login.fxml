      </Text>

      <Text fill="WHITE" layoutX="322.0" layoutY="228.0"
            strokeType="OUTSIDE" strokeWidth="0.0"
            text="H U B">
         <font>
            <Font name="System Bold" size="48.0" />
         </font>
      </Text>

